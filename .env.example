# Copy this file to .env.local and fill in the two values from your Supabase
# project (dashboard -> Connect, or Settings -> API Keys). Restart `npm run dev`
# afterwards. Without them the app runs in demo mode, saving to the browser only.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
